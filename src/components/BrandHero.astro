---
import { about } from '../data/event';
---
<header id="top" class="tb-hero">
  <svg class="tb-map" viewBox="0 0 1000 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="tb-river" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#0c2f3a" stop-opacity=".9" />
        <stop offset="1" stop-color="#10485a" stop-opacity=".7" />
      </linearGradient>
    </defs>
    <g stroke="rgba(127,184,154,.07)" stroke-width="1">
      {Array.from({ length: 14 }, (_, i) => (
        <line x1={i * 77} y1="0" x2={i * 77} y2="560" />
      ))}
      {Array.from({ length: 9 }, (_, i) => (
        <line x1="0" y1={i * 70} x2="1000" y2={i * 70} />
      ))}
    </g>
    <path d="M -40 320 C 140 270 260 245 380 255 C 500 268 580 230 700 175 C 820 122 900 90 1040 60 L 1080 -20 L -40 -20 Z" fill="url(#tb-river)" opacity=".75" />
  </svg>

  <div class="tb-grain" aria-hidden="true"></div>

  <div class="tb-hero-grid">
    <div class="tb-hero-left">
      <div class="tb-eyebrow"><span class="rule"></span> Endurance Events · Chattogram · Bangladesh</div>
      <h1 class="tb-title">Triathlon <span class="acc">Bangladesh</span></h1>
      <p class="tb-mission">{about.mission}</p>
      <a class="tb-scroll" href="#events">Two races on the calendar ↓</a>
    </div>
    <div class="tb-hero-right">
      <img class="tb-hero-logo" src="/assets/triathlon-bd-shield-white.png" alt="Triathlon Bangladesh — Swim, Ride, Run" />
    </div>
  </div>
</header>
