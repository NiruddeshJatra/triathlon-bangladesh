---
import { getEventBySlug, duaLegs, duaMeta, mirMeta, mirCategories, isMirRegistrationOpen } from '../data/event';

const dua = getEventBySlug('duathlon-2026')!;
const mir = getEventBySlug('mirsharai-coastal-marathon-2027')!;

function daysTo(iso: string) {
  return Math.max(0, Math.ceil((new Date(iso).getTime() - Date.now()) / 86400000));
}

const duaDays = daysTo(duaMeta.raceDayISO);
const mirDays = daysTo(mirMeta.flagOffISO);
const mirRegOpen = isMirRegistrationOpen();
---
<section id="events" class="tb-section">
  <div class="tb-shead">
    <div class="eyebrow">Upcoming Events</div>
    <h2 class="stitle">Two start lines <span class="acc">ahead.</span></h2>
  </div>

  <div class="dual-events">
    <article class="dual-card dual-dua">
      <div class="dual-wedge" aria-hidden="true"></div>
      <div class="dual-top">
        <span class="dual-badge open"><span class="dot"></span> Registration Open</span>
        <span class="dual-days">{duaDays} <em>days</em></span>
      </div>
      <h3 class="dual-title">Chattogram<br /><span class="acc">Duathlon 2026</span></h3>
      <p class="dual-tag">{dua.tagline}</p>
      <div class="dual-rbr" aria-label="10K run, 40K bike, 5K run">
        {duaLegs.map((leg) => (
          <span class={`seg ${leg.kind}`} style={`flex-grow:${leg.km}`}>
            <b>{leg.km}K</b> {leg.kind === 'bike' ? 'BIKE' : 'RUN'}
          </span>
        ))}
      </div>
      <dl class="dual-meta">
        <div><dt>Date</dt><dd>{dua.dateDisplay} · Friday</dd></div>
        <div><dt>Venue</dt><dd>{dua.location}</dd></div>
        <div><dt>Entry</dt><dd>{dua.regFee} · 150 slots</dd></div>
      </dl>
      <div class="dual-ctas">
        <a class="dual-btn p" href={dua.registerUrl} target="_blank" rel="noopener noreferrer">Register Now <span>→</span></a>
        <a class="dual-btn s" href={`/events/${dua.slug}`}>Event Page</a>
      </div>
    </article>

    <article class="dual-card dual-cmhm">
      <div class="dual-wedge" aria-hidden="true"></div>
      <div class="dual-top">
        {mirRegOpen
          ? <span class="dual-badge resched">Registration Open</span>
          : <span class="dual-badge resched">Registration opens {mirMeta.registrationOpensDisplay}</span>}
        <span class="dual-days">{mirDays} <em>days</em></span>
      </div>
      <h3 class="dual-title">Mirsharai<br /><span class="acc">Coastal Marathon 2027</span></h3>
      <p class="dual-tag">{mir.tagline}</p>
      <div class="dual-dists" aria-label="42.2, 21.1 and 10 kilometre runs">
        {mirCategories.map((c) => <span>{c.distance.replace(' KM', 'K')}</span>)}
      </div>
      <dl class="dual-meta">
        <div><dt>Date</dt><dd>{mir.dateDisplay} · {mirMeta.weekday}</dd></div>
        <div><dt>Venue</dt><dd>{mirMeta.venueShort}, Mirsharai</dd></div>
        <div><dt>Entry</dt><dd>From {mirCategories[mirCategories.length - 1].regFee}</dd></div>
      </dl>
      <div class="dual-ctas">
        {mirRegOpen && <a class="dual-btn p gold" href={mir.registerUrl} target="_blank" rel="noopener noreferrer">Register Now <span>→</span></a>}
        <a class="dual-btn s gold" href={`/events/${mir.slug}`}>Event Page <span>→</span></a>
      </div>
    </article>
  </div>
</section>
