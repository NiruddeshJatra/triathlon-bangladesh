---
// Toothed bike-cog SVG — 22 teeth, rim, dashed chain-link inner ring,
// 5-arm spider with bolt holes, hub. Replaces the ship's wheel on this page.
// Geometry lives in src/lib/chainring.ts, shared with ChainringCountdown.tsx.
import { getChainringGeometry } from '../../lib/chainring';

interface Props {
  size?: number;
  stroke?: string;
  teeth?: number;
  class?: string;
}
const { size = 116, stroke = 'var(--chart)', teeth = 22, class: className } = Astro.props;
const g = getChainringGeometry(size, teeth);
---
<svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} class={className} style="display:block;overflow:visible" aria-hidden="true">
  <g>
    {g.teeth.map((t) => (
      <rect x={t.x} y={t.y} width={t.width} height={t.height}
        rx={t.rx} fill={stroke} opacity="0.95" transform={`rotate(${t.rotate} ${g.cx} ${g.cy})`} />
    ))}
    <circle cx={g.cx} cy={g.cy} r={g.rimR} fill="none" stroke={stroke} stroke-width={g.rimStrokeWidth} />
    <circle cx={g.cx} cy={g.cy} r={g.innerR} fill="none" stroke={stroke}
      stroke-width={g.innerStrokeWidth} stroke-dasharray={g.innerDash} opacity="0.7" />
    {g.arms.map((l) => (
      <line x1={g.cx} y1={g.cy} x2={l.x2} y2={l.y2} stroke={stroke} stroke-width={g.armStrokeWidth} opacity="0.55" />
    ))}
    {g.bolts.map((b) => (
      <circle cx={b.cx} cy={b.cy} r={b.r} fill="none" stroke={stroke} stroke-width={b.strokeWidth} opacity="0.8" />
    ))}
    <circle cx={g.cx} cy={g.cy} r={g.hubR} fill="var(--bg-base)" stroke={stroke} stroke-width={g.hubStrokeWidth} />
    <circle cx={g.cx} cy={g.cy} r={g.hubDotR} fill={stroke} />
  </g>
</svg>
