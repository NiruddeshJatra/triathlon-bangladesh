---
import { duaEntitlements, duaReveals } from '../../data/event';
---
<section id="get" class="dua-section">
  <div class="dua-shead">
    <div class="eyebrow">04 · What You Get</div>
    <h2 class="stitle">Kit worth the <span class="acc">two transitions.</span></h2>
    <p class="skicker">A pro cycling jersey — not a runner's tee — headlines the race pack. Medal and jersey designs are out.</p>
  </div>
  <div class="dua-get-feature">
    {duaReveals.map((r) => (
      <figure class="dua-get-tile">
        <img class:list={[r.fit]} src={r.img} alt={r.alt} loading="lazy" />
        <figcaption>{r.caption}</figcaption>
      </figure>
    ))}
  </div>
  <ul class="dua-get-list">
    {duaEntitlements.map((it) => (
      <li>
        <div class="g-k">{it.k} {it.soon && <span class="g-soon" lang="bn">শীঘ্রই</span>}</div>
        <div class="g-s">{it.s}</div>
      </li>
    ))}
  </ul>
</section>
