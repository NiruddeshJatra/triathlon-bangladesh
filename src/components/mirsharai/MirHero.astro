---
import CountdownRing from '../../islands/CountdownRing';
import { getEventBySlug, mirMeta, mirCategories, isMirRegistrationOpen } from '../../data/event';

const ev = getEventBySlug('mirsharai-coastal-marathon-2027')!;
const regOpen = isMirRegistrationOpen();
---
<header id="top" class="cmhm-hero cmhm-hero-graphic mir-hero">
  <img class="mir-hero-photo" src={mirMeta.heroPhoto} alt="" loading="eager" aria-hidden="true" />
  <!-- Inline background SVG — terrain grid -->
  <svg class="cmhm-map" viewBox="0 0 1000 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g stroke="rgba(127,184,154,.07)" stroke-width="1">
      {Array.from({ length: 14 }, (_, i) => (
        <line x1={i * 77} y1="0" x2={i * 77} y2="560" />
      ))}
      {Array.from({ length: 9 }, (_, i) => (
        <line x1="0" y1={i * 70} x2="1000" y2={i * 70} />
      ))}
    </g>
  </svg>

  <div class="cmhm-grain" aria-hidden="true"></div>

  <div class="cmhm-hero-grid">
    <div class="hero-left">
      <div class="cmhm-eyebrow"><span class="rule"></span> Triathlon Bangladesh · Mirsharai, Chattogram</div>
      <h1 class="cmhm-title">
        <span class="l1">Mirsharai</span>
        <span class="l2">Coastal Marathon</span>
      </h1>
      <p class="cmhm-tag">
        <em>{mirMeta.motto}</em><br />
        {mirMeta.intro} <span class="muted">{ev.dist} on {ev.dateDisplay}.</span>
      </p>
      <div class="cmhm-cta">
        {regOpen ? (
          <a class="cmhm-btn cmhm-btn-p" href={ev.registerUrl} target="_blank" rel="noopener noreferrer">
            Register Now <span class="arr">→</span>
          </a>
        ) : (
          <span class="cmhm-btn cmhm-btn-p cmhm-btn-closed" aria-disabled="true">Registration opens {mirMeta.registrationOpensDisplay}</span>
        )}
        <a class="cmhm-btn cmhm-btn-s" href="#route">View the Route</a>
      </div>
    </div>
    <div class="hero-right">
      <CountdownRing dateISO={mirMeta.flagOffISO} nowMs={Date.now()} client:idle />
      <a class="cmhm-flag-note" href="#schedule">
        <span class="dot"></span> Flag-off {mirMeta.weekday} {ev.dateDisplay}, {mirMeta.flagOffDisplay} ({mirCategories[0].distance}) → see schedule
      </a>
    </div>
  </div>

  <a href="#facts" class="cmhm-scrollhint" aria-label="Scroll to begin">
    <span>Run the page</span>
    <svg viewBox="0 0 24 28" width="14" height="20">
      <path d="M12 0 v22 M5 16 L12 24 L19 16" stroke="currentColor" stroke-width="1.5" fill="none" />
    </svg>
  </a>
</header>
