---
import '../styles/global.css';
import { event, getEventBySlug } from '../data/event';

const featuredEvent = getEventBySlug('duathlon-2026');

interface Props {
  title?: string;
  description?: string;
  eventJsonLd?: Record<string, unknown>;
  breadcrumbName?: string;
}

const {
  title = featuredEvent ? `${featuredEvent.name} · ${event.organizer}` : `${event.name} ${event.year} · ${event.organizer}`,
  description = `Triathlon Bangladesh organises endurance events — half marathons, duathlons, open-water swims — across Chattogram and coastal Bangladesh.`,
  eventJsonLd,
  breadcrumbName,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://triathlonbangladesh.com';
const canonicalUrl = new URL(Astro.url?.pathname ?? '/', Astro.site ?? `${siteUrl}/`).href;
const currentUrl = canonicalUrl;

const regFeeDigits = featuredEvent?.regFee?.replace(/[^\d]/g, '');

const defaultJsonLdEvent = featuredEvent ? {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": featuredEvent.name,
  "startDate": featuredEvent.date,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": featuredEvent.location,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Chattogram",
      "addressRegion": "Chattogram Division",
      "addressCountry": "BD"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": event.organizer,
    "url": siteUrl
  },
  ...(featuredEvent.registerUrl ? {
    "offers": {
      "@type": "Offer",
      "url": featuredEvent.registerUrl,
      ...(regFeeDigits ? { "price": regFeeDigits } : {}),
      "priceCurrency": "BDT",
      "availability": featuredEvent.registrationOpen !== false ? "https://schema.org/InStock" : "https://schema.org/SoldOut"
    }
  } : {}),
  "image": `${siteUrl}/og-image.jpg`,
  "description": description,
  "sport": "Duathlon",
  "url": siteUrl
} : {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": event.organizer,
  "url": siteUrl,
  "description": description
};

const jsonLdEvent = eventJsonLd ?? defaultJsonLdEvent;

const jsonLdOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": event.organizer,
  "url": siteUrl,
  "logo": `${siteUrl}/og-image.jpg`,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": `+880-${event.contact.phone}`,
    "email": event.contact.email,
    "contactType": "customer service"
  }
};

const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": breadcrumbName ?? `${event.name} ${event.year}`,
      "item": currentUrl
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- OG tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta name="twitter:image" content="/og-image.jpg" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="en_US" />
  <!-- Twitter card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />
  <!-- Geo + locale -->
  <meta name="geo.region" content="BD-B" />
  <meta name="geo.placename" content="Chattogram, Bangladesh" />
  <meta name="geo.position" content={`${event.venueGeo.lat};${event.venueGeo.lng}`} />
  <meta name="ICBM" content={`${event.venueGeo.lat}, ${event.venueGeo.lng}`} />
  <meta http-equiv="content-language" content="en-BD" />
  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdEvent)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
</head>
<body class="bg-bg-base text-text-base">
  <slot />
</body>
</html>
