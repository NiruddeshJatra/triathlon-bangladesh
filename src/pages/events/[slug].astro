---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import WheelDivider from '../../components/WheelDivider.astro';
import Categories from '../../components/Categories.astro';
import Schedule from '../../components/Schedule.astro';
import TheCourse from '../../components/TheCourse.astro';
import Entitlements from '../../components/Entitlements.astro';
import Team from '../../components/Team.astro';
import PartnersSlideshow from '../../components/PartnersSlideshow.astro';
import FAQ from '../../components/FAQ.astro';
import RegisterBand from '../../components/RegisterBand.astro';
import Footer from '../../components/Footer.astro';
import ScrollRoute from '../../islands/ScrollRoute';
import WheelSpin from '../../islands/WheelSpin';
import ChainringSpin from '../../islands/ChainringSpin';
import DuaHero from '../../components/duathlon/DuaHero.astro';
import DuaQuickFacts from '../../components/duathlon/DuaQuickFacts.astro';
import DuaDistances from '../../components/duathlon/DuaDistances.astro';
import DuaCategories from '../../components/duathlon/DuaCategories.astro';
import DuaPrizes from '../../components/duathlon/DuaPrizes.astro';
import DuaEntitlements from '../../components/duathlon/DuaEntitlements.astro';
import DuaFacilities from '../../components/duathlon/DuaFacilities.astro';
import DuaSchedule from '../../components/duathlon/DuaSchedule.astro';
import DuaRules from '../../components/duathlon/DuaRules.astro';
import DuaPacers from '../../components/duathlon/DuaPacers.astro';
import DuaFAQ from '../../components/duathlon/DuaFAQ.astro';
import DuaRegisterBand from '../../components/duathlon/DuaRegisterBand.astro';
import DuaFooter from '../../components/duathlon/DuaFooter.astro';
import GearDivider from '../../components/duathlon/GearDivider.astro';
import DiagonalTape from '../../components/duathlon/DiagonalTape.astro';
import { events, getEventBySlug, org } from '../../data/event';

export function getStaticPaths() {
  return events.map(e => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const eventEntry = getEventBySlug(slug!);

if (!eventEntry) {
  return Astro.redirect('/');
}

const isFullEvent = eventEntry.status === 'current';
const isDuathlon = eventEntry.slug === 'duathlon-2026';

const pageTitle = `${eventEntry.name} · Triathlon Bangladesh`;
const pageDesc = eventEntry.summary;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://triathlonbangladesh.com';

const regFeeDigits = eventEntry.regFee?.replace(/[^\d]/g, '');
const offers = eventEntry.registerUrl ? {
  "@type": "Offer",
  "url": eventEntry.registerUrl,
  ...(regFeeDigits ? { "price": regFeeDigits } : {}),
  "priceCurrency": "BDT",
  "availability": eventEntry.registrationOpen !== false ? "https://schema.org/InStock" : "https://schema.org/SoldOut"
} : undefined;

const duathlonJsonLd = eventEntry.slug === 'duathlon-2026' ? {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": eventEntry.name,
  "startDate": eventEntry.date,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": eventEntry.location,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Noman College Road",
      "addressLocality": "Chattogram",
      "addressRegion": "Chattogram Division",
      "addressCountry": "BD"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": org.name,
    "url": siteUrl
  },
  ...(offers ? { "offers": offers } : {}),
  "image": `${siteUrl}/og-image.jpg`,
  "description": eventEntry.summary,
  "sport": "Duathlon",
  "url": `${siteUrl}/events/${eventEntry.slug}`
} : undefined;
---
<Layout title={pageTitle} description={pageDesc} eventJsonLd={duathlonJsonLd} breadcrumbName={eventEntry.name}>
  {isFullEvent && <ScrollRoute client:visible />}
  {isFullEvent && <WheelSpin client:idle />}
  {isDuathlon && <ChainringSpin client:idle />}
  <Nav />
  <main>
    {isFullEvent ? (
      <>
        <Hero />
        <QuickFacts />
        <WheelDivider label="THE DISTANCES" />
        <Categories />
        <Schedule />
        <WheelDivider label="THE COURSE" />
        <TheCourse />
        <Entitlements />
        <WheelDivider label="THE CREW" />
        <Team />
        {eventEntry.partners && eventEntry.partners.length > 0 && (
          <PartnersSlideshow partners={eventEntry.partners} />
        )}
        <FAQ />
        <WheelDivider label="REGISTER" />
        <RegisterBand />
      </>
    ) : isDuathlon ? (
      <div class="dua-page">
        <DuaHero />
        <DuaQuickFacts />
        <DiagonalTape />
        <GearDivider label="THE DISTANCES" />
        <DuaDistances />
        <GearDivider label="CATEGORIES" />
        <DuaCategories />
        <GearDivider label="PRIZE POOL" />
        <DuaPrizes />
        <GearDivider label="WHAT YOU GET" />
        <DuaEntitlements />
        <GearDivider label="RACE DAY" />
        <DuaFacilities />
        <GearDivider label="SCHEDULE" />
        <DuaSchedule />
        <DiagonalTape text="NON-DRAFTING · 12M DRAFT ZONE · 4HR CUT-OFF" />
        <GearDivider label="RULES & STANDARDS" />
        <DuaRules />
        <GearDivider label="PACERS" />
        <DuaPacers />
        <GearDivider label="FAQ" />
        <DuaFAQ />
        <DuaRegisterBand />
      </div>
    ) : (
      <div class="ev-page">
        {/* Hero */}
        <div class={`ev-page-hero${eventEntry.heroImage ? ' ev-page-hero--img' : ''}`}>
          {eventEntry.heroImage && (
            <img class="ev-page-hero-img" src={eventEntry.heroImage} alt={eventEntry.name} loading="eager" />
          )}
          <div class="ev-page-hero-overlay" aria-hidden="true"></div>
          <div class="ev-page-hero-content">
            <div class="eyebrow ev-page-eyebrow">
              {eventEntry.eventType === 'program' ? 'Training Programme'
               : eventEntry.eventType === 'community' ? 'Rescue Partner · Community'
               : eventEntry.status === 'previous' ? 'Past Event'
               : 'Upcoming Event'}
              {' · '}{eventEntry.dateDisplay}
            </div>
            <h1 class="ev-page-title">{eventEntry.name}</h1>
            {eventEntry.tagline && <p class="ev-page-tagline">{eventEntry.tagline}</p>}
          </div>
        </div>

        {/* Body */}
        <div class="ev-page-body">
          {/* Key facts */}
          <div class="ev-page-facts">
            <div class="ev-fact">
              <div class="ev-fact-label">Date</div>
              <div class="ev-fact-val">{eventEntry.dateDisplay}</div>
            </div>
            <div class="ev-fact">
              <div class="ev-fact-label">Location</div>
              <div class="ev-fact-val">{eventEntry.location}</div>
            </div>
            {eventEntry.dist && (
              <div class="ev-fact">
                <div class="ev-fact-label">Distance</div>
                <div class="ev-fact-val">{eventEntry.dist}</div>
              </div>
            )}
            {eventEntry.runners && (
              <div class="ev-fact">
                <div class="ev-fact-label">Runners</div>
                <div class="ev-fact-val">{eventEntry.runners}</div>
              </div>
            )}
          </div>

          {/* Summary + note */}
          <p class="ev-page-summary">{eventEntry.summary}</p>
          {eventEntry.note && (
            <p class="ev-page-note">{eventEntry.note}</p>
          )}

          {/* CTAs */}
          <div class="ev-page-ctas">
            {eventEntry.registerUrl && eventEntry.status !== 'previous' && eventEntry.registrationOpen !== false && (
              <a class="cmhm-btn cmhm-btn-p" href={eventEntry.registerUrl} target="_blank" rel="noopener noreferrer">
                Register Now <span class="arr">→</span>
              </a>
            )}
            {eventEntry.registerUrl && eventEntry.status !== 'previous' && eventEntry.registrationOpen === false && (
              <span class="cmhm-btn cmhm-btn-p cmhm-btn-closed" aria-disabled="true">Registration Closed</span>
            )}
            <a class="cmhm-btn cmhm-btn-s" href="/">← All Events</a>
          </div>

          {/* Gallery */}
          {eventEntry.gallery && eventEntry.gallery.length > 0 && (
            <div class="ev-page-gallery-wrap">
              <div class="eyebrow ev-gallery-eyebrow">Gallery</div>
              <div class="ev-page-gallery">
                {eventEntry.gallery.map((src, i) => (
                  <div class="ev-gallery-item">
                    <img src={src} alt={`${eventEntry.name} — photo ${i + 1}`} loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </main>
  {isDuathlon ? <DuaFooter /> : <Footer />}
</Layout>
