---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import BrandHero from '../components/BrandHero.astro';
import DualEventFeature from '../components/DualEventFeature.astro';
import WheelDivider from '../components/WheelDivider.astro';
import PreviousEventsList from '../components/PreviousEventsList.astro';
import CommunityInvolvement from '../components/CommunityInvolvement.astro';
import OrgAbout from '../components/OrgAbout.astro';
import Footer from '../components/Footer.astro';
import WheelSpin from '../islands/WheelSpin';
---
<Layout
  title="Triathlon Bangladesh · Endurance Events · Chattogram"
  description="Triathlon Bangladesh organises endurance events — half marathons, duathlons, open-water swims — across Chattogram and coastal Bangladesh. Upcoming: Chattogram Duathlon (6 November 2026)."
>
  <WheelSpin client:idle />
  <Nav />
  <main>
    <BrandHero />
    <DualEventFeature />
    <WheelDivider label="TRACK RECORD" />
    <PreviousEventsList />
    <CommunityInvolvement />
    <WheelDivider label="THE MISSION" />
    <OrgAbout />
  </main>
  <Footer />
</Layout>
